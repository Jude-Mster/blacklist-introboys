          "then": "end",
          "x-base44": {
            "title": "Pay finished Arena bets",
            "description": "Pays bets on finished Live Arena fights for members who left the page"
          }
        }
      }
    ]
  },
  "description": "Every 5 minutes, pay any Blacklist Arena bets on finished Live Arena fights that were not collected yet, so members who closed the page are always paid. Passes a shared secret so the function can reject anonymous callers.",
