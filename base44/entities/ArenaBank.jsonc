      "type": "integer",
      "default": 0
    },
    "total_in": {
      "type": "integer",
      "default": 0
    },
    "total_out": {
      "type": "integer",
      "default": 0
    },
    "log": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "The latest movements, newest first: at, amount, reason"
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}