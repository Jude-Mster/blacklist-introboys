{
  "name": "BuySellDM",
  "type": "object",
  "description": "Wuxen2 Buy and Sell: private messages between visitors",
  "properties": {
    "from_vid": {
      "type": "string"
    },
    "to_vid": {
      "type": "string"
    },
    "pair": {
      "type": "string",
      "description": "The two vids, sorted, joined by |"
    },
    "from_name": {
      "type": "string"
    },
    "from_tag": {
      "type": "string"
    },
    "from_kind": {
      "type": "string"
    },
    "to_name": {
      "type": "string"
    },
    "to_tag": {
      "type": "string"
    },
    "to_kind": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "lang": {
      "type": "string"
    },
    "tr": {
      "type": "object",
      "description": "Translations: en, tl, th, es, pt, id, zh (Traditional Chinese, Taiwan)"
    },
    "image_url": {
      "type": "string"
    },
    "hidden": {
      "type": "boolean",
      "default": false
    },
    "tr_at": {
      "type": "string",
      "description": "6.26: when the translation was saved (set once, even if the translator gave nothing)"
    },
    "owner_vid": {
      "type": "string",
      "description": "6.27: the id of who really sent it (their main id, also when they posted with their name hidden). Never shown"
    },
    "card_discord_id": {
      "type": "string",
      "description": "6.27: a 'my Discord' card: the sender's linked Discord user id"
    },
    "card_discord_name": {
      "type": "string"
    },
    "card_discord_username": {
      "type": "string"
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}
