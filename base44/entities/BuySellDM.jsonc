{
  "name": "BuySellDM",
  "type": "object",
  "description": "Wuxen2 Buy and Sell: private messages between visitors",
  "properties": {
    "from_vid": {
      "type": "string"
    },
    "to_vid": {
      "type": "string"
    },
    "pair": {
      "type": "string",
      "description": "The two vids, sorted, joined by |"
    },
    "from_name": {
      "type": "string"
    },
    "from_tag": {
      "type": "string"
    },
    "from_kind": {
      "type": "string"
    },
    "to_name": {
      "type": "string"
    },
    "to_tag": {
      "type": "string"
    },
    "to_kind": {
      "type": "string"
    },
    "text": {
      "type": "string"
    },
    "lang": {
      "type": "string"
    },
    "tr": {
      "type": "object",
      "description": "Translations: en, tl, th, es, pt, id, zh (Traditional Chinese, Taiwan)"
    },
    "image_url": {
      "type": "string"
    },
    "hidden": {
      "type": "boolean",
      "default": false
    },
    "tr_at": {
      "type": "string",
      "description": "6.26: when the translation was saved (set once, even if the translator gave nothing)"
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}
