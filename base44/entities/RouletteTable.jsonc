{
  "name": "RouletteTable",
  "type": "object",
  "description": "The one shared roulette table: current round and recent results",
  "properties": {
    "round_no": {
      "type": "integer",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "betting",
        "settled"
      ]
    },
    "bets_close_at": {
      "type": "string",
      "format": "date-time"
    },
    "settling_round": {
      "type": "integer",
      "description": "Round whose result has been decided and is being paid out"
    },
    "settled_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_at": {
      "type": "string",
      "format": "date-time"
    },
    "result_number": {
      "type": "integer"
    },
    "result_index": {
      "type": "integer"
    },
    "recent": {
      "type": "array",
      "items": {
        "type": "integer"
      }
    },
    "layout": {
      "type": "string",
      "description": "v2 = the 30-pocket guild wheel (red, black, green, dragon, tiger)"
    },
    "total_bet": {
      "type": "integer",
      "default": 0
    },
    "players": {
      "type": "integer",
      "default": 0
    },
    "lock_token": {
      "type": "string"
    },
    "lock_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}