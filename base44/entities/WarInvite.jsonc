{
  "name": "WarInvite",
  "type": "object",
  "description": "6.33 War Room: invite codes made by the Guild Leader",
  "properties": {
    "code": {
      "type": "string",
      "description": "The code the Guild Leader chose (upper case)"
    },
    "label": {
      "type": "string",
      "description": "Who it is for, e.g. Allied guild leaders"
    },
    "max_uses": {
      "type": "integer",
      "default": 0,
      "description": "0 = no limit"
    },
    "uses": {
      "type": "integer",
      "default": 0
    },
    "access_days": {
      "type": "integer",
      "default": 30,
      "description": "How long people who use it stay in the council"
    },
    "expires_at": {
      "type": "string",
      "description": "When the code stops working (empty = never)"
    },
    "revoked": {
      "type": "boolean",
      "default": false
    },
    "created_by": {
      "type": "string"
    },
    "guild": {
      "type": "string",
      "description": "6.34: the guild these people are from (shown with their names)"
    },
    "color": {
      "type": "string",
      "description": "6.34: the guild's colour on names, e.g. #6cc6ff"
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}
