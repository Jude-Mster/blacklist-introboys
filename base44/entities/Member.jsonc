{
  "name": "Member",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Base44 app user id once the member has logged in; empty until then"
    },
    "discord_id": {
      "type": "string",
      "description": "Discord user id, unique"
    },
    "discord_name": {
      "type": "string",
      "description": "Display name shown on the site (Discord global name, else username)"
    },
    "avatar_url": {
      "type": "string"
    },
    "points": {
      "type": "integer",
      "default": 0
    },
    "role": {
      "type": "string",
      "enum": [
        "member",
        "guild_member",
        "officer",
        "leader"
      ],
      "default": "member",
      "description": "member = Member, guild_member = Guild Member, officer = Vice Guild Member, leader = Guild Leader"
    },
    "daily_claimed_at": {
      "type": "string",
      "format": "date-time"
    },
    "daily_bet_total": {
      "type": "integer",
      "default": 0
    },
    "daily_bet_date": {
      "type": "string",
      "description": "ISO date (YYYY-MM-DD) the daily bet cap applies to"
    },
    "banned": {
      "type": "boolean",
      "default": false
    },
    "lock_token": {
      "type": "string",
      "description": "Short-lived lock so two point changes can't run at once"
    },
    "lock_until": {
      "type": "string",
      "format": "date-time"
    },
    "discord_username": {
      "type": "string",
      "description": "Discord @username"
    },
    "no_access": {
      "type": "boolean",
      "default": false,
      "description": "True when the member no longer holds the required Discord role"
    },
    "access_checked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}