{
  "name": "CardSeat",
  "type": "object",
  "properties": {
    "game": {
      "type": "string"
    },
    "round_no": {
      "type": "integer"
    },
    "seat_no": {
      "type": "integer",
      "description": "Which chair (0-5) the member was sitting in"
    },
    "member_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "avatar": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "wager": {
      "type": "integer",
      "description": "The opening wager"
    },
    "staked": {
      "type": "integer",
      "description": "Total points on this hand: the wager, any side bets, and the extra wager after a double or a split"
    },
    "doubled": {
      "type": "boolean",
      "default": false
    },
    "sides": {
      "type": "object",
      "additionalProperties": true,
      "description": "Side bets placed with the wager: { pairs: n, plus3: n }"
    },
    "side_total": {
      "type": "integer",
      "default": 0,
      "description": "Points on side bets (part of staked)"
    },
    "side_wins": {
      "type": "object",
      "additionalProperties": true,
      "description": "How each side bet came out, decided at the deal"
    },
    "side_payout": {
      "type": "integer",
      "default": 0,
      "description": "What the side bets return; paid with the hand"
    },
    "split_hands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      },
      "description": "After a split: the two hands, each { cards, status, note, doubled, stake, result, payout }"
    },
    "hand_ix": {
      "type": "integer",
      "default": 0,
      "description": "Which split hand is being played"
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "playing",
        "done"
      ],
      "default": "waiting",
      "description": "waiting = bet placed, not dealt yet"
    },
    "note": {
      "type": "string",
      "description": "How the hand ended for the player: stood, bust, blackjack, drew, timeout"
    },
    "result": {
      "type": "string",
      "enum": [
        "blackjack",
        "win",
        "push",
        "lose",
        "void"
      ]
    },
    "payout": {
      "type": "integer",
      "default": 0
    },
    "settled": {
      "type": "boolean",
      "default": false
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}