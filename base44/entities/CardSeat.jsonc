{
  "name": "CardSeat",
  "type": "object",
  "properties": {
    "game": {
      "type": "string"
    },
    "round_no": {
      "type": "integer"
    },
    "member_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "avatar": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "wager": {
      "type": "integer",
      "description": "The opening wager"
    },
    "staked": {
      "type": "integer",
      "description": "Total points on this hand (twice the wager after a double)"
    },
    "doubled": {
      "type": "boolean",
      "default": false
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "playing",
        "done"
      ],
      "default": "waiting",
      "description": "waiting = bet placed, not dealt yet"
    },
    "note": {
      "type": "string",
      "description": "How the hand ended for the player: stood, bust, blackjack, drew, timeout"
    },
    "result": {
      "type": "string",
      "enum": [
        "blackjack",
        "win",
        "push",
        "lose",
        "void"
      ]
    },
    "payout": {
      "type": "integer",
      "default": 0
    },
    "settled": {
      "type": "boolean",
      "default": false
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}