{
  "name": "Settings",
  "type": "object",
  "properties": {
    "guild_id": {
      "type": "string"
    },
    "officer_role_id": {
      "type": "string"
    },
    "min_bet": {
      "type": "integer",
      "default": 10
    },
    "max_bet": {
      "type": "integer",
      "default": 5000
    },
    "daily_bet_cap": {
      "type": "integer",
      "default": 50000
    },
    "house_edge_pct": {
      "type": "integer",
      "default": 3
    },
    "daily_wheel_prizes": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "default": [
        50,
        100,
        150,
        250,
        500,
        1000
      ]
    },
    "award_cap_per_day": {
      "type": "integer",
      "default": 10000
    },
    "games_enabled": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "coinflip",
          "dragondice",
          "lanternslots",
          "skywheel",
          "roulette",
          "blackjack",
          "lucky9",
          "poker",
          "pusoy",
          "fortune",
          "derby"
        ]
      },
      "default": [
        "coinflip",
        "dragondice",
        "lanternslots",
        "skywheel",
        "roulette",
        "blackjack",
        "lucky9",
        "poker"
      ]
    },
    "derby_max_bet": {
      "type": "integer",
      "default": 2000,
      "description": "Most a member can bet on one Blacklist Derby race"
    },
    "discord_invite_url": {
      "type": "string",
      "description": "Invite link shown to people who aren't in the server yet"
    },
    "chat_enabled": {
      "type": "boolean",
      "default": true
    },
    "roulette_bet_seconds": {
      "type": "integer",
      "default": 30
    },
    "duel_max_wager": {
      "type": "integer",
      "default": 0,
      "description": "0 = same as max_bet"
    },
    "wheel_bet_seconds": {
      "type": "integer",
      "default": 20,
      "description": "Betting time per Twelve Skies Wheel round (10-120)"
    },
    "app_download_url": {
      "type": "string",
      "description": "https link to the Android app (APK). Empty = no download prompt."
    },
    "member_role_id": {
      "type": "string",
      "description": "Discord role required to use the site. Empty = anyone in the server."
    },
    "shop_enabled": {
      "type": "boolean",
      "default": true
    },
    "shop_tax_pct": {
      "type": "number",
      "default": 10,
      "description": "Tax added on top of every shop purchase and points purchase, in percent. Removed from circulation."
    },
    "shop_price_multiplier": {
      "type": "number",
      "default": 2,
      "description": "Shop price in points for 1 CP of in-game value"
    },
    "shop_buy_rate": {
      "type": "number",
      "default": 1,
      "description": "Points a member receives per 1 CP paid in-game (before tax)"
    },
    "shop_seeded": {
      "type": "boolean",
      "default": false,
      "description": "True once the starting catalog has been created"
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}