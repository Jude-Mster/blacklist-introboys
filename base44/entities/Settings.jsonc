{
  "name": "Settings",
  "type": "object",
  "properties": {
    "guild_id": {
      "type": "string"
    },
    "officer_role_id": {
      "type": "string"
    },
    "min_bet": {
      "type": "integer",
      "default": 10
    },
    "max_bet": {
      "type": "integer",
      "default": 5000
    },
    "daily_bet_cap": {
      "type": "integer",
      "default": 50000
    },
    "house_edge_pct": {
      "type": "integer",
      "default": 3
    },
    "daily_wheel_prizes": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "default": [
        50,
        100,
        150,
        250,
        500,
        1000
      ]
    },
    "award_cap_per_day": {
      "type": "integer",
      "default": 10000
    },
    "games_enabled": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "coinflip",
          "dragondice",
          "lanternslots",
          "skywheel",
          "roulette",
          "poker"
        ]
      },
      "default": [
        "coinflip",
        "dragondice",
        "lanternslots",
        "skywheel",
        "roulette",
        "poker"
      ]
    },
    "discord_invite_url": {
      "type": "string",
      "description": "Invite link shown to people who aren't in the server yet"
    },
    "chat_enabled": {
      "type": "boolean",
      "default": true
    },
    "roulette_bet_seconds": {
      "type": "integer",
      "default": 30
    },
    "duel_max_wager": {
      "type": "integer",
      "default": 0,
      "description": "0 = same as max_bet"
    },
    "wheel_bet_seconds": {
      "type": "integer",
      "default": 20,
      "description": "Betting time per Twelve Skies Wheel round (10-120)"
    },
    "app_download_url": {
      "type": "string",
      "description": "https link to the Android app (APK). Empty = no download prompt."
    },
    "member_role_id": {
      "type": "string",
      "description": "Discord role required to use the site. Empty = anyone in the server."
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}