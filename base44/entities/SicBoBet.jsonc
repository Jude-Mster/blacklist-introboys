{
  "name": "SicBoBet",
  "type": "object",
  "description": "One member's chips for one Dragon Sic Bo round",
  "properties": {
    "round_no": {
      "type": "integer"
    },
    "member_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "avatar": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "bets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "amount": {
      "type": "integer"
    },
    "payout": {
      "type": "integer",
      "default": 0
    },
    "net": {
      "type": "integer",
      "default": 0
    },
    "settled": {
      "type": "boolean",
      "default": false
    },
    "pay_started": {
      "type": "boolean",
      "default": false,
      "description": "A payout for this bet has been started; a retry checks the points log before paying"
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}