{
  "name": "OAuthState",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "description": "Random opaque token sent to Discord and verified on callback"
    },
    "user_id": {
      "type": "string",
      "description": "The Base44 app user id that initiated the link"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "result": {
      "type": "string",
      "description": "Once the callback has run, the landing path it produced (e.g. /dashboard?linked=1 or /link-discord?error=not_in_guild). Replayed on any repeat hit so the callback is idempotent."
    },
    "consumed_at": {
      "type": "string",
      "format": "date-time"
    },
    "lock_token": {
      "type": "string",
      "description": "Short-lived lock so two concurrent callbacks can't both spend the single-use Discord code"
    },
    "lock_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}