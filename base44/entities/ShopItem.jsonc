{
  "name": "ShopItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "description": "Heading the item is listed under in the shop"
    },
    "description": {
      "type": "string"
    },
    "image_url": {
      "type": "string",
      "description": "Picture shown on the shop card. A site path like /shop/tin-3.png or a full https link."
    },
    "value_cp": {
      "type": "number",
      "description": "In-game value of ONE piece, in CP (1 CP = 0.5 GP = 1M silver). The shop price is this times the shop price multiplier, rounded up."
    },
    "stock": {
      "type": "integer",
      "default": 0
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Hidden from members when false"
    },
    "require_note": {
      "type": "boolean",
      "default": false,
      "description": "Buyer must fill in the note (e.g. which suit they want)"
    },
    "sort": {
      "type": "integer",
      "default": 0
    },
    "gp_code": {
      "type": "boolean",
      "default": false,
      "description": "A GP code: the buyer gets a code shown on the site (and by Discord DM)"
    },
    "gp_worth": {
      "type": "integer",
      "description": "What one code is worth, in GP. The item's value is this x 2 CP."
    },
    "code_source": {
      "type": "string",
      "description": "Empty for ordinary items. stock: taken from the prize-code stock the moment it is bought. manual: the Guild Leader types the code when completing the order."
    },
    "code_label": {
      "type": "string",
      "description": "The prize-code name the codes are kept under, e.g. 500 GP Code"
    },
    "bot_days": {
      "type": "integer",
      "default": 0,
      "description": "More than 0 = an IntroBoys Assistant license: each one bought adds this many days, activated the moment it is paid for"
    },
    "lock_token": {
      "type": "string"
    },
    "lock_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}