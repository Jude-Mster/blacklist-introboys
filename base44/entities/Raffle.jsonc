{
  "name": "Raffle",
  "type": "object",
  "description": "A raffle draw. Members buy tickets with points; the wheel draws a winner per prize.",
  "properties": {
    "title": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "open",
        "drawn",
        "cancelled"
      ],
      "description": "pending: being set up (codes being set aside), not shown yet; open: selling tickets"
    },
    "ticket_price": {
      "type": "integer"
    },
    "max_tickets_per_member": {
      "type": "integer",
      "default": 0
    },
    "ends_at": {
      "type": "string",
      "format": "date-time"
    },
    "prizes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Prize labels in order: first is the top prize"
    },
    "prize_kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "item",
          "points",
          "code"
        ]
      },
      "description": "Kind of each prize, in the same order: item (handed out in game), points (paid automatically), code (prize code sent privately to the winner)"
    },
    "pot_to_first": {
      "type": "boolean",
      "default": true
    },
    "pot": {
      "type": "integer",
      "default": 0
    },
    "tickets_sold": {
      "type": "integer",
      "default": 0
    },
    "winners": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "drawn_at": {
      "type": "string",
      "format": "date-time"
    },
    "announced_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the raffle was last posted to the Discord announcements channel"
    },
    "created_by": {
      "type": "string"
    },
    "lock_token": {
      "type": "string"
    },
    "lock_until": {
      "type": "string",
      "format": "date-time"
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}