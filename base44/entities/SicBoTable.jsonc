{
  "name": "SicBoTable",
  "type": "object",
  "description": "The one shared Dragon Sic Bo table: current round and recent rolls",
  "properties": {
    "round_no": {
      "type": "integer",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "betting",
        "settled"
      ]
    },
    "bets_close_at": {
      "type": "string",
      "format": "date-time"
    },
    "settling_round": {
      "type": "integer",
      "description": "Round whose result has been decided and is being paid out"
    },
    "settling_at": {
      "type": "string",
      "format": "date-time",
      "description": "When a request last started settling this round, so others do not queue behind it"
    },
    "settled_at": {
      "type": "string",
      "format": "date-time"
    },
    "next_at": {
      "type": "string",
      "format": "date-time"
    },
    "result_dice": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "description": "The three dice of the current round. Rolled when the round opens; never sent to members before bets close"
    },
    "recent": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Finished rounds, newest first, each as round:dice like 39:436"
    },
    "total_bet": {
      "type": "integer",
      "default": 0
    },
    "players": {
      "type": "integer",
      "default": 0
    },
    "lock_token": {
      "type": "string"
    },
    "lock_until": {
      "type": "string",
      "format": "date-time"
    },
    "clock": {
      "type": "string",
      "description": "v2 = the round runs on the clock: dice are rolled when the round opens and shown when bets close"
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}