{
  "name": "BuySellUser",
  "type": "object",
  "description": "Wuxen2 Buy and Sell: a visitor who has posted or linked Discord. Linking Discord here never gives members-portal access.",
  "properties": {
    "vid": {
      "type": "string"
    },
    "tag": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "description": "Chosen name (only after linking Discord)"
    },
    "name_lower": {
      "type": "string"
    },
    "discord_id": {
      "type": "string"
    },
    "discord_name": {
      "type": "string"
    },
    "banned": {
      "type": "boolean",
      "default": false
    },
    "banned_by": {
      "type": "string"
    },
    "discord_username": {
      "type": "string"
    },
    "hide_name": {
      "type": "boolean",
      "default": false,
      "description": "6.27: post as Anonymous (under alias_vid for members, a secret-derived id for visitors)"
    },
    "alias_vid": {
      "type": "string",
      "description": "6.27: members only: the random id used while their name is hidden"
    },
    "discord_avatar": {
      "type": "string",
      "description": "6.28: the linked Discord account's picture"
    }
  },
  "rls": {
    "read": false,
    "create": false,
    "update": false,
    "delete": false
  }
}
