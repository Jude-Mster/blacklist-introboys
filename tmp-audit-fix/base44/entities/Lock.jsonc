{
  "name": "Lock",
  "type": "object",
  "properties": {
    "key": { "type": "string", "description": "What is locked, e.g. Member:<id>. A row here means a request is working on, or waiting for, that record." },
    "choosing": { "type": "boolean", "default": false, "description": "True for the instant a request is picking its ticket number" },
    "number": { "type": "integer", "default": 0, "description": "Ticket number. The lowest ticket goes first." },
    "expires_at": { "type": "string", "format": "date-time", "description": "The row is ignored after this time, in case its request crashed" }
  },
  "rls": { "read": false, "create": false, "update": false, "delete": false }
}
